    {
      "cell_type": "code",
      "source": [
        "def recommend_recipe(user_ingredients, diet, skill):\n",
        "\n",
        "    # Convert user input into embedding\n",
        "    user_embedding = model.encode([user_ingredients])\n",
        "\n",
        "    # Similarity score\n",
        "    similarities = cosine_similarity(user_embedding, recipe_embeddings)[0]\n",
        "\n",
        "    recipes[\"Similarity\"] = similarities\n",
        "\n",
        "    # Filter by diet + skill\n",
        "    filtered = recipes[\n",
        "        (recipes[\"Diet\"] == diet) &\n",
        "        (recipes[\"Skill\"] == skill)\n",
        "    ]\n",
        "\n",
        "    if filtered.empty:\n",
        "        return \"No matching recipes found.\"\n",
        "\n",
        "    # Sort by similarity\n",
        "    filtered = filtered.sort_values(\n",
        "        by=\"Similarity\",\n",
        "        ascending=False\n",
        "    )\n",
        "\n",
        "    # Top 3 recipes\n",
        "    top_recipes = filtered.head(3)\n",
        "\n",
        "    output = \"\"\n",
        "\n",
        "    for _, row in top_recipes.iterrows():\n",
        "\n",
        "        output += f\"\"\"\n",
        "🍽 Recipe: {row['Recipe']}\n",
        "\n",
        "🧂 Ingredients:\n",
        "{row['Ingredients']}\n",
        "\n",
        "🔥 Calories:\n",
        "{row['Calories']}\n",
        "\n",
        "⏱ Cooking Time:\n",
        "{row['CookingTime']}\n",
        "\n",
        "-----------------------------------\n",
        "\"\"\"\n",
        "\n",
        "    return output"
      ],
      "metadata": {
        "id": "ESrQianR5DSi"
      },
      "execution_count": 6,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "days = [\n",
        "    \"Monday\",\n",
        "    \"Tuesday\",\n",
        "    \"Wednesday\",\n",
        "    \"Thursday\",\n",
        "    \"Friday\",\n",
        "    \"Saturday\",\n",
        "    \"Sunday\"\n",
        "]\n",
        "\n",
        "\n",
        "def generate_meal_plan(diet, skill):\n",
        "\n",
        "    filtered = recipes[\n",
        "        (recipes[\"Diet\"] == diet) &\n",
        "        (recipes[\"Skill\"] == skill)\n",
        "    ]\n",
        "\n",
        "    if len(filtered) == 0:\n",
        "        return \"No recipes available.\"\n",
        "\n",
        "    meal_plan = \"\"\n",
        "\n",
        "    selected_recipes = filtered.sample(\n",
        "        n=min(7, len(filtered)),\n",
        "        replace=True\n",
        "    )\n",
        "\n",
        "    for day, (_, row) in zip(days, selected_recipes.iterrows()):\n",
        "\n",
        "        meal_plan += f\"\"\"\n",
        "📅 {day}\n",
        "\n",
        "🍽 Meal: {row['Recipe']}\n",
        "🔥 Calories: {row['Calories']}\n",
        "⏱ Time: {row['CookingTime']}\n",
        "\n",
        "-----------------------------\n",
        "\"\"\"\n",
        "\n",
        "    return meal_plan"
      ],
      "metadata": {
        "id": "aFfdg3qS7GFK"
      },
      "execution_count": 7,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def generate_shopping_list(diet, skill):\n",
        "\n",
        "    filtered = recipes[\n",
        "        (recipes[\"Diet\"] == diet) &\n",
        "        (recipes[\"Skill\"] == skill)\n",
        "    ]\n",
        "\n",
        "    ingredients = []\n",
        "\n",
        "    for item in filtered[\"Ingredients\"]:\n",
        "\n",
        "        split_items = item.split()\n",
        "\n",
        "        ingredients.extend(split_items)\n",
        "\n",
        "    unique_ingredients = sorted(set(ingredients))\n",
        "\n",
        "    shopping_list = \"\\n\".join(\n",
        "        [f\"🛒 {item}\" for item in unique_ingredients]\n",
        "    )\n",
        "\n",
        "    return shopping_list"
      ],
      "metadata": {
        "id": "7KaCfOx97LfJ"
      },
      "execution_count": 8,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Recipe Recommendation Interface\n",
        "recipe_interface = gr.Interface(\n",
        "\n",
        "    fn=recommend_recipe,\n",
        "\n",
        "    inputs=[\n",
        "        gr.Textbox(\n",
        "            label=\"Ingredients\",\n",
        "            placeholder=\"tomato onion cheese\"\n",
        "        ),\n",
        "\n",
        "        gr.Dropdown(\n",
        "            [\"vegetarian\", \"non-vegetarian\"],\n",
        "            label=\"Diet Preference\"\n",
        "        ),\n",
        "\n",
        "        gr.Dropdown(\n",
        "            [\"beginner\", \"intermediate\", \"advanced\"],\n",
        "            label=\"Cooking Skill\"\n",
        "        )\n",
        "    ],\n",
        "\n",
        "    outputs=\"text\",\n",
        "\n",
        "    title=\"🍳 Recipe Recommendation Engine\"\n",
        ")\n",
        "\n",
        "\n",
        "# Weekly Meal Planner Interface\n",
        "meal_interface = gr.Interface(\n",
        "\n",
        "    fn=generate_meal_plan,\n",
        "\n",
        "    inputs=[\n",
        "        gr.Dropdown(\n",
        "            [\"vegetarian\", \"non-vegetarian\"],\n",
        "            label=\"Diet Preference\"\n",
        "        ),\n",
        "\n",
        "        gr.Dropdown(\n",
        "            [\"beginner\", \"intermediate\", \"advanced\"],\n",
        "            label=\"Cooking Skill\"\n",
        "        )\n",
        "    ],\n",
        "\n",
        "    outputs=\"text\",\n",
        "\n",
        "    title=\"📅 Weekly Meal Planner\"\n",
        ")\n",
        "\n",
        "\n",
        "# Shopping List Interface\n",
        "shopping_interface = gr.Interface(\n",
        "\n",
        "    fn=generate_shopping_list,\n",
        "\n",
        "    inputs=[\n",
        "        gr.Dropdown(\n",
        "            [\"vegetarian\", \"non-vegetarian\"],\n",
        "            label=\"Diet Preference\"\n",
        "        ),\n",
        "\n",
        "        gr.Dropdown(\n",
        "            [\"beginner\", \"intermediate\", \"advanced\"],\n",
        "            label=\"Cooking Skill\"\n",
        "        )\n",
        "    ],\n",
        "\n",
        "    outputs=\"text\",\n",
        "\n",
        "    title=\"🛒 Shopping List Generator\"\n",
        ")\n",
        "\n",
        "\n",
        "# Combine all tabs\n",
        "app = gr.TabbedInterface(\n",
        "\n",
        "    [\n",
        "        recipe_interface,\n",
        "        meal_interface,\n",
        "        shopping_interface\n",
        "    ],\n",
        "\n",
        "    [\n",
        "        \"Recipe Recommender\",\n",
        "        \"Meal Planner\",\n",
        "        \"Shopping List\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "app.launch()"
      ],
